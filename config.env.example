# ==============================================================================
# VPS Init - 用户配置 V1
# 用途：用于 VPS 自动化初始化、配置与验收。
# ==============================================================================

# ----------------------------------------------------------------------------
# 1. 部署 Profile
# ----------------------------------------------------------------------------
# base-only      : 只做系统初始化，不安装 3x-ui / Reality / Nginx / Lucky。
# reality-only   : 3x-ui + Reality，Reality 直接监听 VPS_IP:443；不需要域名。
#                  订阅默认通过 https://VPS_IP:2096/zhg/<SubID> 暴露。
# nginx-reality  : Nginx Stream + Reality，共用公网 443；必须有域名。
# lucky-reality  : Reality 占公网 443，普通 HTTPS fallback 到 Lucky:8443；必须有域名。
PROFILE="reality-only"

# VPS 商家名称，仅用于 SSH 密钥文件名提示和报告，例如 racknerd / vmiss / dmit。
PROVIDER=""

# 可选的人类可读名称，例如 us-la-01；留空不影响部署。
SERVER_NAME=""

# ----------------------------------------------------------------------------
# 2. SSH
# ----------------------------------------------------------------------------
SSH_PORT="22"

# 只填写公钥，绝对不要填写私钥。
# 例：ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... laptop
#
# 如果留空，脚本会根据 PROVIDER + VPS 公网 IP 输出可直接复制的 Windows PowerShell：
#   ssh-keygen -t ed25519 -f "$env:USERPROFILE\.ssh\id_ed25519_<provider>_<ip无点>" -C "<provider>-<ip>"
#   Get-Content "$env:USERPROFILE\.ssh\id_ed25519_<provider>_<ip无点>.pub" | Set-Clipboard
# 然后脚本暂停，你把公钥粘贴进 config.env 后重新运行。
SSH_PUBLIC_KEY=""

# 可选：本地私钥文件名提示，仅用于打印第二终端测试命令，不会读取或上传私钥。
SSH_IDENTITY_HINT=""

# ----------------------------------------------------------------------------
# 3. 域名 / Cloudflare
# ----------------------------------------------------------------------------
# base-only / reality-only 不需要设置。
# nginx-reality / lucky-reality 必须设置，例如：example.com
ROOT_DOMAIN=""
DNS_PROVIDER="cloudflare"

# Let's Encrypt 联系邮箱，可留空；留空时不会伪造邮箱。
LE_EMAIL=""

# 默认自动派生：
#   xui.<ROOT_DOMAIN>  -> 3x-ui 面板
#   node.<ROOT_DOMAIN> -> 订阅入口 / Reality 节点地址
# 只有想改名字时才填。
PANEL_DOMAIN_OVERRIDE=""
NODE_DOMAIN_OVERRIDE=""

# Cloudflare Token 不写在本文件。
# 固定保存位置：/root/.secrets/cloudflare.ini（权限 600）
# 域名 Profile 首次执行时，脚本会提示：
#   1) 域名已添加到 Cloudflare；
#   2) 注册商 NS 已改为 Cloudflare 分配的 NS；
#   3) Zone 状态已 Active；
#   4) 创建仅限当前 Zone、具备 Zone Read + DNS Write 的 API Token；
#   5) 在交互提示中粘贴 Token。

# ----------------------------------------------------------------------------
# 4. Reality Target
# ----------------------------------------------------------------------------
# auto   : 仅检测下面的小候选列表，选择 3x-ui 判定 feasible 且延迟靠前的目标。
# manual : 完全使用 REALITY_TARGET。
REALITY_TARGET_MODE="auto"
REALITY_TARGET=""
REALITY_CANDIDATES="dl.google.com,www.apple.com,www.microsoft.com,github.io"

# ----------------------------------------------------------------------------
# 5. 订阅服务
# ----------------------------------------------------------------------------
# auto 的解析：
#   base-only      -> 不存在订阅组件
#   reality-only   -> 开启，IP HTTPS 直连
#   nginx-reality  -> 开启，经 Nginx HTTPS 反代
#   lucky-reality  -> 开启，经 Lucky HTTPS 反代
ENABLE_SUBSCRIPTION="auto"
SUBSCRIPTION_EXPOSE_MODE="auto"
SUBSCRIPTION_PORT="2096"

# 3x-ui 面板 URI Path。面板与订阅路径是两个独立设置。
XUI_PANEL_URI_PATH="/zhg/"

# 订阅 URI Path。与面板 URI Path 是独立设置；V1.1 默认同样使用 /zhg/。
# 如手动修改，必须以 / 开头和结尾，例如 /mysub/。
XUI_SUB_URI_PATH="/zhg/"

# Clash/Mihomo 默认：订阅 ON、Routing ON、Auto Detect ON、JSON 订阅 OFF。
# User-Agent 正则固定：(?i)(clash|mihomo)

# ----------------------------------------------------------------------------
# 6. Docker（可选）
# ----------------------------------------------------------------------------
# 默认不安装。开启后使用 Docker 官方仓库安装 Engine / containerd / buildx / compose。
ENABLE_DOCKER="false"

# ----------------------------------------------------------------------------
# 7. 以后可扩展的 Cloudflare 可选模块
# ----------------------------------------------------------------------------
# 不属于核心部署。V1 默认关闭；若打开，脚本会明确停止并提示该扩展尚未启用，
# 避免“看似执行成功、其实没配置”的情况。
ENABLE_CF_WS="false"
ENABLE_CF_PREFERRED="false"
ENABLE_CLOUDFLARESUB="false"
