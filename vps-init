#!/usr/bin/env bash
set -Eeuo pipefail
SELF_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT_DIR="$(cd "$(dirname "$SELF_PATH")" && pwd)"

# shellcheck source=lib/common.sh
source "$ROOT_DIR/lib/common.sh"
source "$ROOT_DIR/lib/backup.sh"
source "$ROOT_DIR/lib/validate.sh"
source "$ROOT_DIR/lib/service.sh"
source "$ROOT_DIR/lib/wizard.sh"
source "$ROOT_DIR/core/preflight.sh"
source "$ROOT_DIR/core/system.sh"
source "$ROOT_DIR/core/swap.sh"
source "$ROOT_DIR/core/network.sh"
source "$ROOT_DIR/core/ssh.sh"
source "$ROOT_DIR/core/firewall.sh"
source "$ROOT_DIR/core/fail2ban.sh"
source "$ROOT_DIR/modules/cloudflare/apply.sh"
source "$ROOT_DIR/modules/certbot/apply.sh"
source "$ROOT_DIR/modules/3x-ui/apply.sh"
source "$ROOT_DIR/modules/subscription/apply.sh"
source "$ROOT_DIR/modules/reality/apply.sh"
source "$ROOT_DIR/modules/nginx/apply.sh"
source "$ROOT_DIR/modules/lucky/apply.sh"
source "$ROOT_DIR/optional/docker/apply.sh"
source "$ROOT_DIR/optional/cf-ws/apply.sh"
source "$ROOT_DIR/optional/cf-preferred/apply.sh"
source "$ROOT_DIR/optional/cloudflaresub/apply.sh"
source "$ROOT_DIR/verify/verify.sh"

VERSION="$(tr -d '[:space:]' < "$ROOT_DIR/VERSION" 2>/dev/null || printf unknown)"
DEFAULT_CFG="$PERSIST_DIR/config.env"
[[ -f "$DEFAULT_CFG" ]] || DEFAULT_CFG="$ROOT_DIR/config.env"

usage() {
  cat <<TXT
VPS Init ${VERSION}
用途：用于 VPS 自动化初始化、配置与验收。

用法：
  vps-init                    # 打开中文交互菜单
  vps-init wizard             # 首次/重新生成配置并部署
  vps-init apply [config.env] # 按配置部署/继续部署
  vps-init verify [config.env]
  vps-init preflight [config.env]
  vps-init status [config.env]
  vps-init info [config.env]
  vps-init secrets
  vps-init update
  vps-init logs
TXT
}

load_runtime_config() {
  local cfg="$1"
  [[ -f "$cfg" ]] || die "未找到配置：$cfg。请先运行 vps-init wizard。"
  load_config "$cfg"
  validate_config
  REQUESTED_PROFILE="$PROFILE"
  state_load
  PREVIOUS_DEPLOYED_PROFILE="${DEPLOYED_PROFILE:-}"
  PROFILE="$REQUESTED_PROFILE"
  resolve_auto_settings
  if [[ -n "$PREVIOUS_DEPLOYED_PROFILE" && "$PREVIOUS_DEPLOYED_PROFILE" != "$PROFILE" && "${VPSINIT_ALLOW_PROFILE_SWITCH:-0}" != "1" ]]; then
    die "该 VPS 已部署 Profile=${PREVIOUS_DEPLOYED_PROFILE}。如需切换到 ${PROFILE}，请运行交互向导确认迁移。"
  fi
}

prepare_profile_transition() {
  [[ -n "${PREVIOUS_DEPLOYED_PROFILE:-}" ]] || return 0

  if [[ "$PREVIOUS_DEPLOYED_PROFILE" != "$PROFILE" ]]; then
    [[ "${VPSINIT_ALLOW_PROFILE_SWITCH:-0}" == "1" ]] || die "Profile 切换未获确认。"
    log_warn "准备切换 Profile：${PREVIOUS_DEPLOYED_PROFILE} -> ${PROFILE}。仅停用/调整 vps-init 管理的冲突服务。"
  fi

  # Reconcile project-managed topology even when DEPLOYED_PROFILE already
  # matches the requested Profile. A failed migration can otherwise leave the
  # service graph half-switched while state/config still point at the last
  # verified Profile.
  case "$PROFILE" in
    nginx-reality)
      systemctl disable --now lucky >/dev/null 2>&1 || true
      systemctl disable --now vps-init-landing >/dev/null 2>&1 || true
      if ! systemctl is-active --quiet nginx 2>/dev/null &&
         systemctl is-active --quiet x-ui 2>/dev/null &&
         ss -H -ltnp 'sport = :443' 2>/dev/null | grep -qi xray; then
        log_warn "检测到失败迁移残留：443 当前由 Xray 占用；先停止 x-ui，随后恢复 Nginx Stream + Reality 1443。"
        systemctl stop x-ui >/dev/null 2>&1 || true
      fi
      ;;
    reality-only)
      systemctl disable --now nginx >/dev/null 2>&1 || true
      systemctl disable --now lucky >/dev/null 2>&1 || true
      systemctl disable --now vps-init-landing >/dev/null 2>&1 || true
      ;;
    lucky-reality)
      if ! systemctl is-active --quiet nginx 2>/dev/null &&
         systemctl is-active --quiet x-ui 2>/dev/null &&
         ss -H -ltnp 'sport = :443' 2>/dev/null | grep -qi xray; then
        log_warn "检测到旧版/失败迁移残留：443 当前由 Xray 占用；先停止 x-ui，随后切换为 Nginx Stream + Reality 1443 + Lucky 8443。"
        systemctl stop x-ui >/dev/null 2>&1 || true
      fi
      ;;
    base-only)
      systemctl disable --now x-ui >/dev/null 2>&1 || true
      systemctl disable --now nginx >/dev/null 2>&1 || true
      systemctl disable --now lucky >/dev/null 2>&1 || true
      systemctl disable --now vps-init-landing >/dev/null 2>&1 || true
      ;;
  esac
}

show_status_summary() {
  local cfg="$1"
  load_runtime_config "$cfg"
  echo "VPS Init ${VERSION}"
  echo "Profile           : $PROFILE"
  echo "Server            : ${SERVER_NAME:-}"
  echo "IPv4              : ${SERVER_IP:-未部署/未知}"
  echo "SSH Port          : $SSH_PORT"
  if profile_has_xui; then
    echo "3x-ui Panel Path  : ${XUI_WEB_BASE_PATH:-${XUI_PANEL_URI_PATH:-/zhg/}}"
    echo "Subscription Path : ${SUBSCRIPTION_PATH:-${XUI_SUB_URI_PATH:-/zhg/}}"
    echo "Subscription Port : ${SUBSCRIPTION_PORT_SELECTED:-$SUBSCRIPTION_PORT}"
    echo "Reality Target    : ${REALITY_TARGET_SELECTED:-${REALITY_TARGET_MODE}}"
  fi
  [[ -f "$REPORT_FILE" ]] && echo "Report            : $REPORT_FILE"
  [[ -f "$SECRETS_FILE" ]] && echo "Secrets           : $SECRETS_FILE (600)"
}

show_info_summary() {
  local cfg="$1" panel_url="" sub_base="" reality_public=""
  load_runtime_config "$cfg"
  state_load
  echo "============================================================"
  echo "                 VPS Init 部署信息"
  echo "============================================================"
  echo "VPS Init           : $VERSION"
  echo "Deployed Version   : ${DEPLOYED_VERSION:-未记录}"
  echo "Profile            : $PROFILE"
  echo "Server             : ${SERVER_NAME:-}"
  echo "IPv4               : ${SERVER_IP:-unknown}"
  echo "SSH                : root@${SERVER_IP:-unknown}:${SSH_PORT}"
  echo "SSH Auth           : vps-main / key-only"
  echo
  echo "已安装/管理组件："
  printf '  %-18s %s\n' "Fail2ban" "$(systemctl is-active fail2ban 2>/dev/null || echo inactive)"
  printf '  %-18s %s\n' "UFW" "$(ufw status 2>/dev/null | awk -F': ' '/^Status:/{print $2; exit}' || true)"
  if profile_has_xui; then
    printf '  %-18s %s\n' "3x-ui" "${XUI_VERSION:-unknown} ($(systemctl is-active x-ui 2>/dev/null || echo inactive))"
    printf '  %-18s %s\n' "Xray" "3x-ui bundled"
  fi
  if [[ "$PROFILE" == "nginx-reality" ]]; then
    printf '  %-18s %s\n' "Nginx" "$(systemctl is-active nginx 2>/dev/null || echo inactive)"
  fi
  if [[ "$PROFILE" == "lucky-reality" ]]; then
    printf '  %-18s %s\n' "Lucky" "$(systemctl is-active lucky 2>/dev/null || echo inactive)"
  fi
  if is_true "${ENABLE_DOCKER:-false}"; then
    printf '  %-18s %s\n' "Docker" "$(systemctl is-active docker 2>/dev/null || echo inactive)"
  else
    printf '  %-18s %s\n' "Docker" "未启用"
  fi

  if profile_has_xui; then
    echo
    echo "3x-ui / Reality："
    echo "  Panel Listen      : 127.0.0.1:${XUI_PANEL_PORT:-unknown}"
    echo "  Panel Path        : ${XUI_WEB_BASE_PATH:-unknown}"
    echo "  Subscription      : 127.0.0.1:${SUBSCRIPTION_PORT_SELECTED:-${SUBSCRIPTION_PORT:-unknown}}${SUBSCRIPTION_PATH:-}"
    echo "  Reality Target    : ${REALITY_TARGET_SELECTED:-unknown}"
    echo "  Reality SNI       : ${REALITY_SERVER_NAME:-unknown}"
    if [[ "$PROFILE" == "nginx-reality" ]]; then
      echo "  Public 443        : Nginx Stream"
      echo "  Reality Route     : 443 -> 127.0.0.1:1443"
      echo "  HTTPS Route       : 443 -> 127.0.0.1:8443"
    else
      echo "  Public 443        : Xray Reality"
    fi

    if profile_has_domain; then
      panel_url="https://${PANEL_DOMAIN}${XUI_WEB_BASE_PATH}"
      sub_base="https://${NODE_DOMAIN}${SUBSCRIPTION_PATH}"
      reality_public="${NODE_DOMAIN}:443"
    else
      panel_url="SSH tunnel -> http://127.0.0.1:${XUI_PANEL_PORT}${XUI_WEB_BASE_PATH}"
      sub_base="https://${SERVER_IP}:${SUBSCRIPTION_PORT_SELECTED:-$SUBSCRIPTION_PORT}${SUBSCRIPTION_PATH}"
      reality_public="${SERVER_IP}:443"
    fi
    echo "  Reality Public    : $reality_public"
    echo "  Panel URL         : $panel_url"
    echo "  Subscription Base : $sub_base"
  fi

  echo
  echo "重要文件："
  echo "  Config             : $PERSIST_DIR/config.env"
  echo "  State              : $STATE_FILE"
  echo "  Report             : $REPORT_FILE"
  echo "  Secrets            : $SECRETS_FILE"
  echo
  echo "敏感内容默认不显示。完整订阅 URL、3x-ui 密码和 Reality 分享链接请运行："
  echo "  vps-init secrets"
  echo "============================================================"
}

show_logs() {
  state_load
  echo "===== x-ui ====="
  systemctl status x-ui --no-pager 2>/dev/null || true
  journalctl -u x-ui -n 80 --no-pager 2>/dev/null || true
  if [[ "${DEPLOYED_PROFILE:-}" == "nginx-reality" ]]; then
    echo "===== nginx ====="
    systemctl status nginx --no-pager 2>/dev/null || true
    journalctl -u nginx -n 80 --no-pager 2>/dev/null || true
  fi
  if [[ "${DEPLOYED_PROFILE:-}" == "lucky-reality" ]]; then
    echo "===== lucky ====="
    systemctl status lucky --no-pager 2>/dev/null || true
    journalctl -u lucky -n 80 --no-pager 2>/dev/null || true
  fi
  echo "===== fail2ban ====="
  systemctl status fail2ban --no-pager 2>/dev/null || true
}

update_self() {
  local source_file="$PERSIST_DIR/.source.env" repo ref
  [[ -r "$source_file" ]] || die "未记录 GitHub 来源。请重新运行项目 README 中的一键安装命令。"
  # shellcheck disable=SC1090
  source "$source_file"
  repo="${VPSINIT_REPO:-}"; ref="${VPSINIT_BOOTSTRAP_REF:-main}"
  [[ -n "$repo" && "$repo" == */* ]] || die "GitHub 仓库来源尚未配置。"
  log_info "从 GitHub 更新 VPS Init：${repo}@${ref}"
  # Reuse the already installed bootstrap instead of executing a newly fetched
  # unverified install.sh. The bootstrap itself prefers SHA256-verified Releases.
  VPSINIT_REPO="$repo" VPSINIT_BOOTSTRAP_REF="$ref" bash "$ROOT_DIR/install.sh" --update --no-menu
  log_ok "更新完成。重新执行：vps-init"
}

menu() {
  require_root
  [[ -t 0 ]] || die "交互菜单需要 TTY。"
  while true; do
    clear 2>/dev/null || true
    wizard_banner
    echo
    [[ -f "$DEFAULT_CFG" ]] && { state_load; echo "当前 Profile：${DEPLOYED_PROFILE:-未部署}"; echo; }
    cat <<'TXT'
  1. 一键部署 / 继续部署
  2. 运行验收
  3. 查看部署信息
  4. 查看当前状态
  5. 查看敏感凭据
  6. 编辑配置
  7. 更新 VPS Init
  8. 查看服务日志
  9. 重新运行安装向导
  0. 退出
TXT
    local n
    read -r -p "请选择 [0-9]: " n
    case "$n" in
      1)
        if [[ -f "$DEFAULT_CFG" ]]; then
          "$ROOT_DIR/vps-init" apply "$DEFAULT_CFG" || true
        else
          local wizard_rc=0
          "$ROOT_DIR/vps-init" wizard || wizard_rc=$?
          (( wizard_rc == 42 )) && exit 0
        fi
        ;;
      2) "$ROOT_DIR/vps-init" verify "$DEFAULT_CFG" || true ;;
      3) show_info_summary "$DEFAULT_CFG" || true ;;
      4) show_status_summary "$DEFAULT_CFG" || true ;;
      5)
        if [[ -f "$SECRETS_FILE" ]]; then
          echo "警告：下面包含密码、API Token/节点参数等敏感信息。"
          if wizard_yesno "确认显示？" n; then cat "$SECRETS_FILE"; fi
        else echo "尚未生成凭据文件。"; fi
        ;;
      6)
        [[ -f "$DEFAULT_CFG" ]] || { echo "尚无配置，先运行安装向导。"; "$ROOT_DIR/vps-init" wizard; continue; }
        "${EDITOR:-vi}" "$DEFAULT_CFG"
        ;;
      7) update_self || true ;;
      8) show_logs || true ;;
      9)
        local wizard_rc=0
        "$ROOT_DIR/vps-init" wizard || wizard_rc=$?
        (( wizard_rc == 42 )) && exit 0
        ;;
      0) exit 0 ;;
      *) echo "输入无效。" ;;
    esac
    echo
    read -r -p "按 Enter 返回菜单..." _
  done
}

cmd="${1:-menu}"
cfg="${2:-$DEFAULT_CFG}"
case "$cmd" in
  menu) menu; exit 0 ;;
  wizard|install) require_root; wizard_run "$PERSIST_DIR/config.env"; exit $? ;;
  secrets) require_root; [[ -f "$SECRETS_FILE" ]] || die "尚未生成 $SECRETS_FILE"; cat "$SECRETS_FILE"; exit 0 ;;
  logs) require_root; show_logs; exit 0 ;;
  update) require_root; update_self; exit 0 ;;
  status) require_root; show_status_summary "$cfg"; exit 0 ;;
  info) require_root; show_info_summary "$cfg"; exit 0 ;;
  apply|verify|preflight) ;;
  -h|--help|help) usage; exit 0 ;;
  *) usage; die "未知命令: $cmd" ;;
esac

require_root
load_runtime_config "$cfg"

if [[ "$cmd" == preflight ]]; then core_preflight; exit 0; fi
if [[ "$cmd" == verify ]]; then verify_all; exit $?; fi

log_info "开始部署 Profile: $PROFILE"
prepare_profile_transition
core_preflight
# SSH key is handled before package upgrades or other system mutations. If the
# public key is missing, the run stops here after printing copyable PowerShell.
core_ssh
core_system
resolve_runtime_ports
core_swap
core_network
core_firewall
core_fail2ban
optional_docker
optional_cf_preferred
optional_cloudflaresub

if profile_has_xui; then
  module_xui
  if profile_has_domain; then
    module_cloudflare
    module_certbot_domain
  fi
  module_subscription
  module_reality
  case "$PROFILE" in
    nginx-reality) module_nginx ;;
    lucky-reality)
      module_lucky
      module_nginx
      ;;
  esac
  optional_cf_ws
fi

copy_project_persistent

echo >> "$SECRETS_FILE" 2>/dev/null || true
chmod 600 "$SECRETS_FILE" 2>/dev/null || true

if verify_all; then
  persist_config "$cfg"
  state_set DEPLOYED_PROFILE "$PROFILE"
  state_set DEPLOYED_VERSION "$VERSION"
  state_set DEPLOYMENT_VERIFIED_AT "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  log_ok "全部阶段完成；Profile 已在验收通过后写入部署状态。"
else
  die "部署完成但验收存在失败项，请查看 $REPORT_FILE。"
fi

if [[ -f /var/run/reboot-required ]]; then
  log_warn "系统提示需要重启。建议执行 reboot，重新登录后运行：vps-init verify"
else
  log_info "可选的冷启动验收：reboot 后运行 vps-init verify"
fi
log_info "敏感凭据（root-only）：$SECRETS_FILE"
log_info "验收报告（不含密码/Token/私钥）：$REPORT_FILE"
