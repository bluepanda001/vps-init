#!/usr/bin/env bash
set -Eeuo pipefail
SELF_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT_DIR="$(cd "$(dirname "$SELF_PATH")" && pwd)"

# shellcheck source=lib/common.sh
source "$ROOT_DIR/lib/common.sh"
source "$ROOT_DIR/lib/backup.sh"
source "$ROOT_DIR/lib/validate.sh"
source "$ROOT_DIR/lib/service.sh"
source "$ROOT_DIR/lib/wizard.sh"
source "$ROOT_DIR/lib/credentials.sh"
source "$ROOT_DIR/lib/network_tools.sh"
source "$ROOT_DIR/core/preflight.sh"
source "$ROOT_DIR/core/system.sh"
source "$ROOT_DIR/core/swap.sh"
source "$ROOT_DIR/core/network.sh"
source "$ROOT_DIR/core/ssh.sh"
source "$ROOT_DIR/core/firewall.sh"
source "$ROOT_DIR/core/fail2ban.sh"
source "$ROOT_DIR/modules/cloudflare/apply.sh"
source "$ROOT_DIR/modules/certbot/apply.sh"
source "$ROOT_DIR/modules/3x-ui/apply.sh"
source "$ROOT_DIR/modules/subscription/apply.sh"
source "$ROOT_DIR/modules/reality/apply.sh"
source "$ROOT_DIR/modules/nginx/apply.sh"
source "$ROOT_DIR/modules/lucky/apply.sh"
source "$ROOT_DIR/optional/docker/apply.sh"
source "$ROOT_DIR/optional/cf-ws/apply.sh"
source "$ROOT_DIR/optional/cf-preferred/apply.sh"
source "$ROOT_DIR/optional/cloudflaresub/apply.sh"
source "$ROOT_DIR/verify/verify.sh"

VPSINIT_VERSION="$(tr -d '[:space:]' < "$ROOT_DIR/VERSION" 2>/dev/null || printf unknown)"
DEFAULT_CFG="$PERSIST_DIR/config.env"
[[ -f "$DEFAULT_CFG" ]] || DEFAULT_CFG="$ROOT_DIR/config.env"

usage() {
  cat <<TXT
VPS Init ${VPSINIT_VERSION}
用途：用于 VPS 自动化初始化、配置与验收。

用法：
  vps-init                    # 打开中文交互菜单
  vps-init wizard             # 首次/重新生成配置并部署
  vps-init apply [config.env] # 按配置部署/继续部署
  vps-init verify [config.env]
  vps-init preflight [config.env]
  vps-init status [config.env]
  vps-init info [config.env]
  vps-init secrets             # 中文分组显示
  vps-init secrets --raw       # 原始 KEY=VALUE
  vps-init passwd               # 修改/重置并同步面板账号密码
  vps-init passwd xui|lucky
  vps-init gateway              # 查看当前 Web Gateway / Lucky 管理入口
  vps-init reinstall            # 单独进入系统重装 / 一键 DD
  vps-init update
  vps-init upgrade-system        # 手动执行完整 apt upgrade
  vps-init network-tools          # 网络调优 / TCP 测速菜单
  vps-init tcpfit [args]          # TCPFit 调优（固定上游版本）
  vps-init tcpquality [mode]      # IPv4 三网测速；默认 speed
  vps-init logs
TXT
}

load_runtime_config() {
  local cfg="$1"
  [[ -f "$cfg" ]] || die "未找到配置：$cfg。请先运行 vps-init wizard。"
  load_config "$cfg"
  validate_config
  REQUESTED_PROFILE="$PROFILE"
  state_load
  PREVIOUS_DEPLOYED_PROFILE="${DEPLOYED_PROFILE:-}"
  PROFILE="$REQUESTED_PROFILE"
  resolve_auto_settings
  if [[ -n "$PREVIOUS_DEPLOYED_PROFILE" && "$PREVIOUS_DEPLOYED_PROFILE" != "$PROFILE" && "${VPSINIT_ALLOW_PROFILE_SWITCH:-0}" != "1" ]]; then
    die "该 VPS 已部署 Profile=${PREVIOUS_DEPLOYED_PROFILE}。如需切换到 ${PROFILE}，请运行交互向导确认迁移。"
  fi
}

prepare_profile_transition() {
  [[ -n "${PREVIOUS_DEPLOYED_PROFILE:-}" ]] || return 0

  if [[ "$PREVIOUS_DEPLOYED_PROFILE" != "$PROFILE" ]]; then
    [[ "${VPSINIT_ALLOW_PROFILE_SWITCH:-0}" == "1" ]] || die "Profile 切换未获确认。"
    log_warn "准备切换 Profile：${PREVIOUS_DEPLOYED_PROFILE} -> ${PROFILE}。仅停用/调整 vps-init 管理的冲突服务。"
  fi

  # Reconcile project-managed topology even when DEPLOYED_PROFILE already
  # matches the requested Profile. A failed migration can otherwise leave the
  # service graph half-switched while state/config still point at the last
  # verified Profile.
  case "$PROFILE" in
    nginx-reality)
      systemctl disable --now lucky >/dev/null 2>&1 || true
      systemctl disable --now vps-init-landing >/dev/null 2>&1 || true
      if ! systemctl is-active --quiet nginx 2>/dev/null &&
         systemctl is-active --quiet x-ui 2>/dev/null &&
         ss -H -ltnp 'sport = :443' 2>/dev/null | grep -qi xray; then
        log_warn "检测到失败迁移残留：443 当前由 Xray 占用；先停止 x-ui，随后恢复 Nginx Stream + Reality 1443。"
        systemctl stop x-ui >/dev/null 2>&1 || true
      fi
      ;;
    lucky-web)
      systemctl disable --now nginx >/dev/null 2>&1 || true
      systemctl disable --now x-ui >/dev/null 2>&1 || true
      ;;
    reality-only)
      systemctl disable --now nginx >/dev/null 2>&1 || true
      systemctl disable --now lucky >/dev/null 2>&1 || true
      systemctl disable --now vps-init-landing >/dev/null 2>&1 || true
      ;;
    lucky-reality)
      if ! systemctl is-active --quiet nginx 2>/dev/null &&
         systemctl is-active --quiet x-ui 2>/dev/null &&
         ss -H -ltnp 'sport = :443' 2>/dev/null | grep -qi xray; then
        log_warn "检测到旧版/失败迁移残留：443 当前由 Xray 占用；先停止 x-ui，随后切换为 Nginx Stream + Reality 1443 + Lucky 8443。"
        systemctl stop x-ui >/dev/null 2>&1 || true
      fi
      ;;
    base-only)
      systemctl disable --now x-ui >/dev/null 2>&1 || true
      systemctl disable --now nginx >/dev/null 2>&1 || true
      systemctl disable --now lucky >/dev/null 2>&1 || true
      systemctl disable --now vps-init-landing >/dev/null 2>&1 || true
      ;;
  esac
}

show_status_summary() {
  local cfg="$1"
  load_runtime_config "$cfg"
  echo "VPS Init ${VPSINIT_VERSION}"
  echo "Profile           : $PROFILE"
  echo "Server            : ${SERVER_NAME:-}"
  echo "IPv4              : ${SERVER_IP:-未部署/未知}"
  echo "SSH Port          : $SSH_PORT"
  if [[ "$PROFILE" == "lucky-web" ]]; then
    echo "Lucky Domain       : https://${LUCKY_DOMAIN}/${LUCKY_SAFE_URL:-zhg}"
    echo "Lucky Safe Entry   : ${LUCKY_SAFE_URL:-zhg}"
    echo "Web Gateway        : Lucky direct :443"
    echo "Docker             : ${ENABLE_DOCKER}"
  fi
  if profile_has_xui; then
    echo "3x-ui Panel Path  : ${XUI_WEB_BASE_PATH:-${XUI_PANEL_URI_PATH:-/zhg/}}"
    echo "Subscription Path : ${SUBSCRIPTION_PATH:-${XUI_SUB_URI_PATH:-/zhg/}}"
    echo "Subscription Port : ${SUBSCRIPTION_PORT_SELECTED:-$SUBSCRIPTION_PORT}"
    echo "Reality Target    : ${REALITY_TARGET_SELECTED:-${REALITY_TARGET_MODE}}"
  fi
  [[ -f "$REPORT_FILE" ]] && echo "Report            : $REPORT_FILE"
  [[ -f "$SECRETS_FILE" ]] && echo "Secrets           : $SECRETS_FILE (600)"
}

show_info_summary() {
  local cfg="$1" panel_url="" sub_base="" reality_public=""
  load_runtime_config "$cfg"
  state_load
  echo "============================================================"
  echo "                 VPS Init 部署信息"
  echo "============================================================"
  echo "VPS Init           : $VPSINIT_VERSION"
  echo "Deployed Version   : ${DEPLOYED_VERSION:-未记录}"
  echo "Profile            : $PROFILE"
  echo "Server             : ${SERVER_NAME:-}"
  echo "IPv4               : ${SERVER_IP:-unknown}"
  echo "SSH                : root@${SERVER_IP:-unknown}:${SSH_PORT}"
  echo "SSH Auth           : vps-main / key-only"
  echo
  echo "已安装/管理组件："
  printf '  %-18s %s\n' "Fail2ban" "$(systemctl is-active fail2ban 2>/dev/null || echo inactive)"
  printf '  %-18s %s\n' "UFW" "$(ufw status 2>/dev/null | awk -F': ' '/^Status:/{print $2; exit}' || true)"
  if profile_has_xui; then
    printf '  %-18s %s\n' "3x-ui" "${XUI_VERSION:-unknown} ($(systemctl is-active x-ui 2>/dev/null || echo inactive))"
    printf '  %-18s %s\n' "Xray" "3x-ui bundled"
