  if [[ "$PROFILE" == "nginx-reality" || "$PROFILE" == "lucky-reality" ]]; then
    printf '  %-18s %s\n' "Nginx Stream" "$(systemctl is-active nginx 2>/dev/null || echo inactive)"
  fi
