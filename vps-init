show_logs() {
  state_load
  echo "===== x-ui ====="
  systemctl status x-ui --no-pager 2>/dev/null || true
  journalctl -u x-ui -n 80 --no-pager 2>/dev/null || true
  if [[ "${DEPLOYED_PROFILE:-}" == "nginx-reality" || "${DEPLOYED_PROFILE:-}" == "lucky-reality" ]]; then
    echo "===== nginx stream ====="
    systemctl status nginx --no-pager 2>/dev/null || true
    journalctl -u nginx -n 80 --no-pager 2>/dev/null || true
  fi
  if [[ "${DEPLOYED_PROFILE:-}" == "lucky-reality" || "${DEPLOYED_PROFILE:-}" == "lucky-web" ]]; then
    echo "===== lucky ====="
    systemctl status lucky --no-pager 2>/dev/null || true
    journalctl -u lucky -n 80 --no-pager 2>/dev/null || true
  fi
  echo "===== fail2ban ====="
  systemctl status fail2ban --no-pager 2>/dev/null || true
}

update_self() {
  local source_file="$PERSIST_DIR/.source.env" repo ref
  [[ -r "$source_file" ]] || die "未记录 GitHub 来源。请重新运行项目 README 中的一键安装命令。"
  # shellcheck disable=SC1090
  source "$source_file"
  repo="${VPSINIT_REPO:-}"; ref="${VPSINIT_BOOTSTRAP_REF:-main}"
  [[ -n "$repo" && "$repo" == */* ]] || die "GitHub 仓库来源尚未配置。"
  log_info "从 GitHub 更新 VPS Init：${repo}@${ref}"
  # Reuse the already installed bootstrap instead of executing a newly fetched
  # unverified install.sh. The bootstrap itself prefers SHA256-verified Releases.
  VPSINIT_REPO="$repo" VPSINIT_BOOTSTRAP_REF="$ref" bash "$ROOT_DIR/install.sh" --update --no-menu
  log_ok "更新完成。重新执行：vps-init"
}

menu() {
  require_root
  [[ -t 0 ]] || die "交互菜单需要 TTY。"
  while true; do
    clear 2>/dev/null || true
    wizard_banner
    echo
    [[ -f "$DEFAULT_CFG" ]] && { state_load; echo "当前 Profile：${DEPLOYED_PROFILE:-未部署}"; echo; }
    cat <<'TXT'
  1. 核心部署 / 继续部署
  2. 运行核心验收
  3. 查看部署信息
  4. 查看当前状态
  5. 查看敏感凭据
  6. 修改管理账号 / 密码
  7. Web Gateway / Lucky
  8. 编辑配置
  9. 更新 VPS Init
 10. 查看服务日志
 11. 重新运行核心安装向导
 12. 系统重装 / 一键 DD
 13. 系统完整升级（apt upgrade）
 14. 网络调优 / TCP 测速
  0. 退出
TXT
    local n
    read -r -p "请选择 [0-14]: " n
    case "$n" in
      1)
        if [[ -f "$DEFAULT_CFG" ]]; then
          "$ROOT_DIR/vps-init" apply "$DEFAULT_CFG" || true
        else
          local wizard_rc=0
          "$ROOT_DIR/vps-init" wizard || wizard_rc=$?
          (( wizard_rc == 42 )) && exit 0
        fi
        ;;
      2) "$ROOT_DIR/vps-init" verify "$DEFAULT_CFG" || true ;;
      3) show_info_summary "$DEFAULT_CFG" || true ;;
      4) show_status_summary "$DEFAULT_CFG" || true ;;
      5)
        if [[ -f "$SECRETS_FILE" ]]; then
          echo "警告：下面包含密码、API Token/节点参数等敏感信息。"
          if wizard_yesno "确认显示？" n; then show_secrets_pretty; fi
        else echo "尚未生成凭据文件。"; fi
        ;;
      6) credential_menu || true ;;
      7) show_gateway_summary "$DEFAULT_CFG" || true ;;
      8)
        [[ -f "$DEFAULT_CFG" ]] || { echo "尚无配置，先运行安装向导。"; "$ROOT_DIR/vps-init" wizard; continue; }
        "${EDITOR:-vi}" "$DEFAULT_CFG"
        ;;
      9) update_self || true ;;
      10) show_logs || true ;;
      11)
        local wizard_rc=0
        "$ROOT_DIR/vps-init" wizard || wizard_rc=$?
        (( wizard_rc == 42 )) && exit 0
        ;;
      12) "$ROOT_DIR/vps-init" reinstall; exit 0 ;;
      13) core_system_upgrade || true ;;
      14) network_tools_menu || true ;;
      0) exit 0 ;;
      *) echo "输入无效。" ;;
    esac
    echo
    read -r -p "按 Enter 返回菜单..." _
  done
}

cmd="${1:-menu}"
cfg="${2:-$DEFAULT_CFG}"
case "$cmd" in
  menu) menu; exit 0 ;;
  wizard|install) require_root; wizard_run "$PERSIST_DIR/config.env"; exit $? ;;
  secrets)
    require_root
    [[ -f "$SECRETS_FILE" ]] || die "尚未生成 $SECRETS_FILE"
    case "${2:-}" in
      "") show_secrets_pretty ;;
      --raw) cat "$SECRETS_FILE" ;;
      *) die "secrets 仅支持：vps-init secrets 或 vps-init secrets --raw" ;;
    esac
    exit 0
    ;;
  passwd) require_root; credential_command "${2:-}"; exit 0 ;;
  reinstall) require_root; wizard_reinstall; exit 0 ;;
  gateway) require_root; show_gateway_summary "$DEFAULT_CFG"; exit 0 ;;
  logs) require_root; show_logs; exit 0 ;;
  update) require_root; update_self; exit 0 ;;
  upgrade-system) require_root; core_system_upgrade; exit 0 ;;
  network-tools) require_root; network_tools_menu; exit 0 ;;
  tcpfit) require_root; network_tools_tcpfit "${@:2}"; exit $? ;;
  tcpquality) require_root; network_tools_tcpquality "${@:2}"; exit $? ;;
  status) require_root; show_status_summary "$cfg"; exit 0 ;;
  info) require_root; show_info_summary "$cfg"; exit 0 ;;
  apply|verify|preflight) ;;
  -h|--help|help) usage; exit 0 ;;
  *) usage; die "未知命令: $cmd" ;;
esac

require_root
load_runtime_config "$cfg"

if [[ "$cmd" == preflight ]]; then core_preflight; exit 0; fi
if [[ "$cmd" == verify ]]; then verify_all; exit $?; fi

log_info "开始部署 Profile: $PROFILE"
prepare_profile_transition
core_preflight
# SSH key is handled before package upgrades or other system mutations. If the
# public key is missing, the run stops here after printing copyable PowerShell.
core_ssh
core_system
resolve_runtime_ports
core_swap
core_network
core_firewall
core_fail2ban
optional_docker
optional_cf_preferred
optional_cloudflaresub

if [[ "$PROFILE" == "lucky-web" ]]; then
  module_cloudflare
  module_certbot_domain
  module_lucky
elif profile_has_xui; then
  module_xui
  if profile_has_domain; then
    module_cloudflare
    module_certbot_domain
  fi
  module_subscription
  module_reality
  case "$PROFILE" in
    nginx-reality) module_nginx ;;
    lucky-reality)
      module_lucky
      module_nginx
      ;;
  esac
  optional_cf_ws
fi

copy_project_persistent

echo >> "$SECRETS_FILE" 2>/dev/null || true
chmod 600 "$SECRETS_FILE" 2>/dev/null || true

if verify_all; then
  persist_config "$cfg"
  state_set DEPLOYED_PROFILE "$PROFILE"
  state_set DEPLOYED_VERSION "$VPSINIT_VERSION"
  state_set DEPLOYMENT_VERIFIED_AT "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  log_ok "全部阶段完成；Profile 已在验收通过后写入部署状态。"
else
  die "部署完成但验收存在失败项，请查看 $REPORT_FILE。"
fi

if [[ -f /var/run/reboot-required ]]; then
  log_warn "系统提示需要重启。建议执行 reboot，重新登录后运行：vps-init verify"
else
  log_info "可选的冷启动验收：reboot 后运行 vps-init verify"
fi
log_info "敏感凭据（root-only）：$SECRETS_FILE"
log_info "验收报告（不含密码/Token/私钥）：$REPORT_FILE"
